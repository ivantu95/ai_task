# Токен Telegram-бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=your_token

# API-ключ Groq (получить бесплатно на https://console.groq.com)
GROQ_API_KEY=your_token

# Время ежедневного утреннего напоминания со списком задач (формат ЧЧ:ММ)
REMINDER_TIME=08:00

# Часовой пояс (например: Europe/Moscow, Asia/Yekaterinburg, Europe/Kaliningrad, UTC)
TIMEZONE=Europe/Chisinau
