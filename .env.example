# Токен Telegram-бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API-ключ Groq (получить бесплатно на https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Время утреннего списка задач (формат ЧЧ:ММ, по умолчанию 08:00)
REMINDER_TIME=08:00

# Время вечернего обзора дня с предложением перенести задачи на завтра (формат ЧЧ:ММ, по умолчанию 21:00)
EVENING_TIME=21:00

# Часовой пояс (например: Europe/Chisinau, Europe/Moscow, UTC)
TIMEZONE=Europe/Chisinau

# Модель Groq для анализа текста (опционально, по умолчанию выбирается автоматически)
# GROQ_MODEL=llama-3.3-70b-versatile

# Использовать ли локальную нейросеть для семантического поиска (PyTorch + SentenceTransformers + FAISS).
# По умолчанию: false (рекомендуется: бот потребляет ~30 МБ RAM и 0% CPU).
USE_LOCAL_EMBEDDINGS=false
