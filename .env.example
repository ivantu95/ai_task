# Токен Telegram-бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API-ключ Groq (получить бесплатно на https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Время ежедневного утреннего напоминания со списком задач (формат ЧЧ:ММ)
REMINDER_TIME=08:00

# Часовой пояс (например: Europe/Chisinau, Europe/Moscow, UTC)
TIMEZONE=Europe/Chisinau

# Модель Groq для анализа текста (опционально, если пусто - определится автоматически)
# GROQ_MODEL=llama-3.3-70b-versatile
